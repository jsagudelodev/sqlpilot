# Copia este archivo como .env (está en .gitignore). Las variables ya definidas en el sistema tienen prioridad.

# ----- LLM ---------------------------------------------------------------
SQLPILOT_LLM_PROVEEDOR=gemini            # anthropic | openai | gemini | ollama
SQLPILOT_LLM_MODELO=gemini-2.5-flash     # gemini-2.5-pro | claude-opus-5 | gpt-4.1 | qwen2.5-coder:14b
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
